---
import type { Room } from '../data/rooms';
import { brl } from '../lib/format';
import { priceFrom } from '../data/rooms';
interface Props { room: Room }
const { room } = Astro.props;
const from = priceFrom(room);
const cap = `${room.baseOccupancy} pessoas, até ${room.maxOccupancy} com cama extra`;
---
<article class="group overflow-hidden rounded-[var(--radius-ficha)] border border-mar/10 bg-white transition hover:shadow-ficha">
  <a href={`/acomodacoes/${room.slug}`} class="block">
    <div class="foto-placeholder relative aspect-[4/3] overflow-hidden">
      <img src={room.photos[0].src} alt={room.photos[0].alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" onerror="this.remove()" />
      <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-mar backdrop-blur">{room.short}</span>
    </div>
    <div class="p-5">
      <h3 class="text-xl font-bold">{room.name}</h3>
      <p class="mt-1 text-sm text-neblina">{cap}</p>
      <p class="mt-3 line-clamp-2 text-sm text-mar/80">{room.description}</p>
      <div class="mt-4 flex items-end justify-between">
        <div>
          {from ? (
            <><p class="text-xs text-neblina">a partir de, para 2</p><p class="text-lg font-bold">{brl(from)}<span class="text-xs font-normal text-neblina"> / noite</span></p></>
          ) : (
            <p class="text-sm font-semibold text-mar-claro">Consultar tarifa</p>
          )}
        </div>
        <span class="btn-linha !py-2 !px-4 text-sm group-hover:border-mar/60">Ver quarto</span>
      </div>
    </div>
  </a>
</article>
