---
/** Varal de luzes discreto, em cima das seções de festas e eventos. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const xs = [40, 120, 200, 280, 360, 440, 520, 600, 680, 760, 840, 920];
---
<svg class:list={['luzes-faixa', cls]} viewBox="0 0 960 48" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 6 Q240 46 480 14 T960 6" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5"/>
  <g class="bulbos">{xs.map((x, i) => <circle cx={x} cy={i % 2 ? 30 - (i % 3) * 3 : 18 + (i % 3) * 4} r="4" fill="#f5a524" style={`--d:${(i * 0.4) % 2.4}s`} />)}</g>
</svg>
