---
import { pousada, bookingMode, bookingEngineUrl } from '../data/pousada';
interface Props {
  /** nome da categoria pré-selecionada (página de quarto) */
  room?: string;
  roomSlug?: string;
  compact?: boolean;
  id?: string;
  /** desenha o calendário embutido abaixo dos campos (página do apartamento) */
  inlineCalendar?: boolean;
  /** pacote pré-selecionado (página de pacote) */
  packageSlug?: string;
  /** datas fixas do pacote: vira uma lista de opções no lugar do calendário */
  fixedDates?: { checkin: string; checkout: string; label: string }[];
  /** dica sobre noites e dias de check-in do pacote */
  hint?: string;
}
const { room = '', roomSlug = '', compact = false, id = 'reservar', inlineCalendar = false, packageSlug = '', fixedDates = [], hint = '' } = Astro.props;
const cfg = { whatsapp: pousada.whatsapp, mode: bookingMode, engineUrl: bookingEngineUrl };
---
<form id={id} class:list={['ficha relative p-4 sm:p-5 scroll-mt-24', compact ? '' : 'md:p-6']} data-booking data-cfg={JSON.stringify(cfg)} data-room-slug={roomSlug} data-inline={inlineCalendar ? '1' : ''} novalidate>
  <input type="hidden" name="checkin" />
  <input type="hidden" name="checkout" />
  {packageSlug && <input type="hidden" name="package" value={packageSlug} />}
  {fixedDates.length > 0 && (
    <div class="mb-3">
      <span class="rotulo">Datas do pacote</span>
      <div class="flex flex-wrap gap-2">
        {fixedDates.map((f) => <button type="button" class="btn-linha !py-2 !px-4 text-sm" data-fixed-date data-ci={f.checkin} data-co={f.checkout}>{f.label}</button>)}
      </div>
    </div>
  )}
  <div class:list={['grid gap-3', compact ? 'grid-cols-2' : 'grid-cols-2 lg:grid-cols-[1.1fr_1.1fr_0.7fr_0.8fr_0.8fr_auto] lg:items-end']}>
    <div class:list={fixedDates.length > 0 && 'hidden'}>
      <span class="rotulo">Chegada</span>
      <button type="button" class="campo campo-data" data-trigger="checkin" aria-haspopup="dialog">
        <svg class="h-4 w-4 shrink-0 text-mar-claro" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 8h14M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span data-val>Escolher</span>
      </button>
    </div>
    <div class:list={fixedDates.length > 0 && 'hidden'}>
      <span class="rotulo">Saída</span>
      <button type="button" class="campo campo-data" data-trigger="checkout" aria-haspopup="dialog">
        <svg class="h-4 w-4 shrink-0 text-mar-claro" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 8h14M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span data-val>Escolher</span>
      </button>
    </div>
    <div class:list={compact && 'col-span-2'}>
      <label class="rotulo" for={`${id}-ad`}>Adultos</label>
      <select class="campo" id={`${id}-ad`} name="adults">
        {[1,2,3,4].map((n) => <option value={n} selected={n === 2}>{n}</option>)}
      </select>
    </div>
    <div>
      <label class="rotulo" for={`${id}-k6`}>Até 6 anos</label>
      <select class="campo" id={`${id}-k6`} name="kids6">
        {[0,1,2].map((n) => <option value={n}>{n}</option>)}
      </select>
    </div>
    <div>
      <label class="rotulo" for={`${id}-k7`}>7 a 12 anos</label>
      <select class="campo" id={`${id}-k7`} name="kids7">
        {[0,1,2].map((n) => <option value={n}>{n}</option>)}
      </select>
    </div>
    {room && <input type="hidden" name="room" value={room} data-slug={roomSlug} />}
    <button type="submit" class:list={['btn-sol w-full col-span-2', compact ? '' : 'lg:col-span-1 lg:w-auto']}>
      Ver disponibilidade
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neblina">
    <span data-noites class="font-semibold text-mar"></span>
    <span>{hint || (bookingMode === 'interno' ? 'Preço e vaga na hora, sem taxa de reserva.' : 'Resposta pelo WhatsApp em poucos minutos, das 7h às 22h.')}</span>
    <span class="text-falesia font-medium" data-erro hidden></span>
  </p>
  {inlineCalendar && <div class="mt-4" data-inline-mount></div>}
</form>
<script>
  import { initBooking } from '../lib/booking';
  document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((f) => {
    if (f.dataset.ready) return;
    f.dataset.ready = '1';
    initBooking(f, JSON.parse(f.dataset.cfg || '{}'));
  });
</script>
