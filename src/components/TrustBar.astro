---
const items = [
  { t: '2 min a pé', s: 'da Praia Novo Prado', i: 'M3 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0M12 3v4' },
  { t: 'Café incluso', s: 'servido todos os dias', i: 'M4 8h12v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8zm12 2h2a2 2 0 0 1 0 4h-2M7 4v2m3-2v2m3-2v2' },
  { t: 'Estacionamento', s: 'gratuito, no terreno', i: 'M5 17h14M6 17l1.5-6h9L18 17M8 11l1-4h6l1 4M7 20v-3m10 3v-3' },
  { t: 'Piscina', s: 'ao ar livre, com jardim', i: 'M3 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0M7 14V6a2 2 0 0 1 4 0M13 14V6a2 2 0 0 1 4 0' },
];
---
<section class="container-site -mt-2 md:-mt-4" aria-label="O essencial">
  <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
    {items.map((x) => (
      <li class="flex items-center gap-3 rounded-2xl border border-mar/10 bg-white px-4 py-3.5">
        <svg class="h-7 w-7 shrink-0 text-mar-claro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={x.i}/></svg>
        <div><p class="font-semibold leading-tight">{x.t}</p><p class="text-xs text-neblina">{x.s}</p></div>
      </li>
    ))}
  </ul>
</section>
