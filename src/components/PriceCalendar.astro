---
/** Calendário mensal com preço e vaga por dia. Busca /api/calendario no navegador. */
interface Props { roomSlug: string; formId?: string }
const { roomSlug, formId = 'reservar' } = Astro.props;
---
<div class="ficha p-4" data-calendar data-room={roomSlug} data-form={formId}>
  <div class="flex items-center justify-between">
    <button type="button" class="btn-linha !px-3 !py-1.5 text-sm" data-prev aria-label="Mês anterior">‹</button>
    <p class="font-bold capitalize" data-title>…</p>
    <button type="button" class="btn-linha !px-3 !py-1.5 text-sm" data-next aria-label="Próximo mês">›</button>
  </div>
  <div class="mt-3 grid grid-cols-7 text-center text-[11px] font-semibold uppercase tracking-wider text-neblina">
    {['D','S','T','Q','Q','S','S'].map((d) => <span>{d}</span>)}
  </div>
  <div class="mt-1 grid grid-cols-7 gap-1" data-grid></div>
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-neblina">
    <span><span class="inline-block h-2.5 w-2.5 rounded-sm bg-sol/60 align-middle"></span> alta temporada</span>
    <span><span class="inline-block h-2.5 w-2.5 rounded-sm bg-mar/15 align-middle"></span> sem vaga</span>
    <span data-hint></span>
  </p>
</div>
<script>
  const brl = (v: number) => 'R$ ' + v.toLocaleString('pt-BR', { maximumFractionDigits: 0 });
  document.querySelectorAll<HTMLElement>('[data-calendar]').forEach((el) => {
    const room = el.dataset.room!;
    const form = document.getElementById(el.dataset.form || 'reservar') as HTMLFormElement | null;
    const ci = form?.querySelector<HTMLInputElement>('[name=checkin]');
    const co = form?.querySelector<HTMLInputElement>('[name=checkout]');
    const grid = el.querySelector<HTMLElement>('[data-grid]')!;
    const title = el.querySelector<HTMLElement>('[data-title]')!;
    const hint = el.querySelector<HTMLElement>('[data-hint]')!;
    const now = new Date();
    let y = now.getFullYear(), m = now.getMonth() + 1;
    let picking: 'in' | 'out' = 'in';

    const render = async () => {
      title.textContent = new Date(y, m - 1, 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      grid.innerHTML = '<p class="col-span-7 py-6 text-center text-sm text-neblina">Carregando…</p>';
      let days: any[] = [];
      try {
        const r = await fetch(`/api/calendario?room=${room}&month=${y}-${String(m).padStart(2, '0')}`);
        days = (await r.json()).days || [];
      } catch { grid.innerHTML = '<p class="col-span-7 py-6 text-center text-sm text-falesia">Não foi possível carregar.</p>'; return; }
      grid.innerHTML = '';
      const first = new Date(y, m - 1, 1).getDay();
      for (let i = 0; i < first; i++) grid.appendChild(document.createElement('span'));
      for (const d of days) {
        const b = document.createElement('button');
        b.type = 'button';
        const sel = (ci?.value && d.date === ci.value) || (co?.value && d.date === co.value);
        const between = ci?.value && co?.value && d.date > ci.value && d.date < co.value;
        const off = d.past || d.available < 1;
        b.disabled = off;
        b.className = [
          'flex min-h-12 flex-col items-center justify-center rounded-lg border text-[11px] leading-tight transition',
          off ? 'cursor-not-allowed border-transparent bg-mar/10 text-neblina line-through' : 'border-mar/10 hover:border-mar/50',
          !off && d.tier !== 'baixa' ? 'bg-sol/15' : '',
          sel ? '!bg-mar !text-espuma !border-mar' : between ? '!bg-mar/15' : '',
        ].join(' ');
        b.innerHTML = `<span class="font-bold text-sm">${+d.date.slice(-2)}</span><span>${off ? '—' : brl(d.price)}</span>`;
        b.title = off ? (d.past ? 'Data passada' : 'Sem vaga') : `${brl(d.price)} por noite · ${d.available} vaga(s)` + (d.minNights > 1 ? ` · mín. ${d.minNights} noites` : '');
        b.addEventListener('click', () => {
          if (!ci || !co) return;
          if (picking === 'in' || d.date <= ci.value) { ci.value = d.date; co.value = ''; picking = 'out'; hint.textContent = 'Agora escolha a saída.'; }
          else { co.value = d.date; picking = 'in'; hint.textContent = ''; co.dispatchEvent(new Event('change')); form?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          ci.dispatchEvent(new Event('change'));
          render();
        });
        grid.appendChild(b);
      }
    };
    el.querySelector('[data-prev]')!.addEventListener('click', () => { if (--m < 1) { m = 12; y--; } render(); });
    el.querySelector('[data-next]')!.addEventListener('click', () => { if (++m > 12) { m = 1; y++; } render(); });
    render();
  });
</script>
