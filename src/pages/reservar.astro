---
import Base from '../layouts/Base.astro';
import BookingBar from '../components/BookingBar.astro';
import { pousada } from '../data/pousada';
---
<Base title="Reservar" description="Escolha as datas, veja preço e vaga por apartamento e reserve direto com a Pousada Orla do Sol." noSticky noindex>
  <section class="container-site max-w-4xl pt-8 md:pt-12" id="app" data-wa={pousada.whatsapp} data-checkin={pousada.checkIn} data-checkout={pousada.checkOut}>
    <p class="text-sm text-neblina">Carregando…</p>
    <noscript><p class="mt-4 rounded-lg bg-falesia/10 px-3 py-2 text-sm text-falesia">A reserva online precisa de JavaScript. Fale com a gente pelo WhatsApp {pousada.phoneDisplay}.</p></noscript>
  </section>
  <template id="tpl-booking"><BookingBar id="reservar" /></template>
  <script>
    import { mountReservar } from '../lib/ui-reservar';
    mountReservar(document.getElementById('app')!);
  </script>
</Base>
