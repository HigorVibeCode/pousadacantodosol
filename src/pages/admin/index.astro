---
import Base from '../../layouts/Base.astro';
import { listReservations, listBlocks, occupancyGrid, todayIso, fmtDate, brl, addDays } from '../../lib/engine';
import { rooms, getRoom, totalRooms } from '../../data/rooms';
import { getDb } from '../../lib/db';
export const prerender = false;

const today = todayIso();
const erro = Astro.url.searchParams.get('erro');
const [reservas, bloqueios, grade, db] = await Promise.all([listReservations({ from: today }), listBlocks(today), occupancyGrid(today, 30), getDb()]);
const pendentes = reservas.filter((r) => r.status === 'pendente');
const hoje = reservas.filter((r) => r.status !== 'cancelada' && r.checkin <= today && r.checkout > today);
const receita = reservas.filter((r) => r.status === 'confirmada').reduce((s, r) => s + r.total_cents, 0) / 100;
const dia = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('pt-BR', { day: '2-digit', timeZone: 'UTC' });
const dow = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'narrow', timeZone: 'UTC' });
const statusCls: Record<string, string> = { pendente: 'bg-sol/20 text-mar', confirmada: 'bg-palmeira/15 text-palmeira', cancelada: 'bg-falesia/10 text-falesia' };
---
<Base title="Painel" noSticky noindex>
  <section class="container-site pt-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">Painel da pousada</p>
        <h1 class="mt-1 text-3xl font-extrabold">Reservas e ocupação</h1>
      </div>
      <form method="post" action="/api/admin/logout"><button class="btn-linha !py-2 !px-4 text-sm">Sair</button></form>
    </div>
    {db.kind === 'pglite-memory' && <p class="mt-4 rounded-lg bg-falesia/10 px-3 py-2 text-sm text-falesia">Banco em memória: as reservas somem a cada reinício. Crie um Postgres (Neon) na Vercel e defina <code>DATABASE_URL</code>.</p>}
    {erro && <p class="mt-4 rounded-lg bg-falesia/10 px-3 py-2 text-sm text-falesia">{erro}</p>}

    <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
      <li class="ficha p-4"><p class="text-xs text-neblina">Pedidos a confirmar</p><p class="text-3xl font-extrabold">{pendentes.length}</p></li>
      <li class="ficha p-4"><p class="text-xs text-neblina">Hospedados hoje</p><p class="text-3xl font-extrabold">{hoje.length}<span class="text-sm font-normal text-neblina"> / {totalRooms} quartos</span></p></li>
      <li class="ficha p-4"><p class="text-xs text-neblina">Reservas futuras</p><p class="text-3xl font-extrabold">{reservas.filter((r) => r.status !== 'cancelada').length}</p></li>
      <li class="ficha p-4"><p class="text-xs text-neblina">Receita confirmada</p><p class="text-3xl font-extrabold">{brl(receita)}</p></li>
    </ul>

    <h2 class="mt-10 text-xl font-bold" id="ocupacao">Vagas nos próximos 30 dias</h2>
    <p class="text-sm text-neblina">Cada célula mostra quantas unidades da categoria ainda estão livres naquela noite.</p>
    <div class="mt-3 overflow-x-auto rounded-[var(--radius-ficha)] border border-mar/10 bg-white">
      <table class="text-xs">
        <thead>
          <tr><th class="sticky left-0 bg-white px-3 py-2 text-left">Categoria</th>{grade.dates.map((d) => <th class="px-1 py-2 text-center font-normal text-neblina"><span class="block">{dow(d)}</span><span class="font-semibold text-mar">{dia(d)}</span></th>)}</tr>
        </thead>
        <tbody>
          {grade.rows.map((row) => (
            <tr class="border-t border-mar/10">
              <td class="sticky left-0 bg-white px-3 py-2 font-semibold whitespace-nowrap">{row.room.name} <span class="text-neblina">({row.room.units})</span></td>
              {row.cells.map((c) => (
                <td class="px-0.5 py-1 text-center">
                  <span class:list={['inline-block w-7 rounded py-1 font-semibold', c.free === 0 ? 'bg-falesia text-white' : c.free < c.units ? 'bg-sol/40' : 'bg-palmeira/15 text-palmeira']}>{c.free}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-10 text-xl font-bold" id="reservas">Reservas</h2>
    {reservas.length === 0 ? <p class="mt-2 text-sm text-neblina">Nenhuma reserva futura ainda. Quando um hóspede reservar pelo site, ela aparece aqui.</p> : (
      <div class="mt-3 overflow-x-auto rounded-[var(--radius-ficha)] border border-mar/10 bg-white">
        <table class="w-full min-w-[720px] text-sm">
          <thead class="bg-espuma text-xs uppercase tracking-wider text-neblina"><tr><th class="px-3 py-2 text-left">Código</th><th class="px-3 py-2 text-left">Hóspede</th><th class="px-3 py-2 text-left">Acomodação</th><th class="px-3 py-2 text-left">Datas</th><th class="px-3 py-2 text-right">Total</th><th class="px-3 py-2 text-left">Status</th><th class="px-3 py-2"></th></tr></thead>
          <tbody class="divide-y divide-mar/10">
            {reservas.map((r) => (
              <tr>
                <td class="px-3 py-2 font-semibold"><a href={`/reserva/${r.code}`} class="underline-offset-4 hover:underline">{r.code}</a></td>
                <td class="px-3 py-2">{r.guest_name}<br /><a href={`https://wa.me/55${String(r.guest_phone).replace(/^55/, '')}`} target="_blank" rel="noopener" class="text-xs text-mar-claro">{r.guest_phone}</a>{r.notes && <p class="text-xs text-neblina">{r.notes}</p>}</td>
                <td class="px-3 py-2">{getRoom(r.room_type)?.name}<br /><span class="text-xs text-neblina">{r.adults} ad.{r.kids6 ? ` + ${r.kids6} cr. ≤6` : ''}{r.kids7 ? ` + ${r.kids7} cr. 7+` : ''}</span></td>
                <td class="px-3 py-2 whitespace-nowrap">{fmtDate(r.checkin)} → {fmtDate(r.checkout)}</td>
                <td class="px-3 py-2 text-right font-semibold">{brl(r.total_cents / 100)}</td>
                <td class="px-3 py-2"><span class:list={['rounded-full px-2 py-0.5 text-xs font-semibold', statusCls[r.status]]}>{r.status}</span></td>
                <td class="px-3 py-2">
                  <form method="post" action="/api/admin/status" class="flex gap-1">
                    <input type="hidden" name="id" value={r.id} />
                    {r.status !== 'confirmada' && <button name="status" value="confirmada" class="rounded-full bg-palmeira px-2.5 py-1 text-xs font-semibold text-white">Confirmar</button>}
                    {r.status !== 'cancelada' && <button name="status" value="cancelada" class="rounded-full border border-falesia/40 px-2.5 py-1 text-xs font-semibold text-falesia">Cancelar</button>}
                    {r.status === 'cancelada' && <button name="status" value="pendente" class="rounded-full border border-mar/20 px-2.5 py-1 text-xs font-semibold">Reabrir</button>}
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <h2 class="mt-10 text-xl font-bold" id="bloqueios">Bloquear datas</h2>
    <p class="text-sm text-neblina">Para manutenção, uso próprio ou reservas feitas por telefone e pela Booking. O bloqueio tira unidades da venda no site.</p>
    <form method="post" action="/api/admin/bloqueio" class="ficha mt-3 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_0.6fr_1.2fr_auto] lg:items-end">
      <div><label class="rotulo">Categoria</label><select class="campo" name="room">{rooms.map((r) => <option value={r.slug}>{r.name}</option>)}</select></div>
      <div><label class="rotulo">De (noite)</label><input class="campo" type="date" name="start" required min={today} /></div>
      <div><label class="rotulo">Até (saída)</label><input class="campo" type="date" name="end" required min={addDays(today, 1)} /></div>
      <div><label class="rotulo">Unid.</label><input class="campo" type="number" name="qty" value="1" min="1" /></div>
      <div><label class="rotulo">Motivo</label><input class="campo" name="reason" placeholder="Ex.: reserva por telefone, Maria" /></div>
      <button class="btn-mar text-sm">Bloquear</button>
    </form>
    {bloqueios.length > 0 && (
      <ul class="mt-3 divide-y divide-mar/10 rounded-[var(--radius-ficha)] border border-mar/10 bg-white text-sm">
        {bloqueios.map((b) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5">
            <span><strong>{getRoom(b.room_type)?.name}</strong> · {b.qty} unid. · {fmtDate(b.start_date)} → {fmtDate(b.end_date)} {b.reason && <span class="text-neblina">· {b.reason}</span>}</span>
            <form method="post" action="/api/admin/bloqueio"><input type="hidden" name="acao" value="remover" /><input type="hidden" name="id" value={b.id} /><button class="text-xs font-semibold text-falesia">Remover</button></form>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
