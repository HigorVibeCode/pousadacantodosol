{
  "redirects": [
    {
      "source": "/quartos",
      "destination": "/acomodacoes",
      "permanent": true
    },
    {
      "source": "/acomodacoes-em-prado-ba",
      "destination": "/acomodacoes",
      "permanent": true
    },
    {
      "source": "/a-pousada",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fotos",
      "destination": "/acomodacoes",
      "permanent": true
    },
    {
      "source": "/o-que-fazer-em-prado-ba",
      "destination": "/localizacao",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
