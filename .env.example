# URL pública do site (usada em sitemap, canonical e dados estruturados)
PUBLIC_SITE_URL=https://pousadacantodosol.vercel.app
# ID do contêiner do Google Tag Manager (GTM-XXXXXXX). Vazio = não carrega.
PUBLIC_GTM_ID=
# Modo do botão principal: "whatsapp" (fase 1) ou "engine" (fase 2, motor de reservas)
PUBLIC_BOOKING_MODE=interno
# URL do motor de reservas com placeholders {checkin} {checkout} {adults} {children} (fase 2)
PUBLIC_BOOKING_ENGINE_URL=

# --- Motor de reservas próprio ---
# Modo do botão principal: "interno" (motor próprio), "whatsapp" ou "engine" (fornecedor externo)
# PUBLIC_BOOKING_MODE=interno
# Banco Postgres (Neon pela Vercel Marketplace injeta DATABASE_URL ou POSTGRES_URL).
# Sem isso, roda um Postgres embutido em .data/ (local) ou em memória (Vercel, sem persistência).
DATABASE_URL=
# Senha do painel do dono em /admin
ADMIN_PASSWORD=

# Prévia estática (artefato): APIs respondem no navegador. Nunca ligar na Vercel.
PUBLIC_DEMO=
